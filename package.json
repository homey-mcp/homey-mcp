{
  "name": "homey-mcp",
  "version": "2.4.0",
  "description": "MCP server for Homey Pro smart home control",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "homey-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "homey",
    "smart-home",
    "home-automation",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "homey-api": "^3.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "homey-api": {
      "ws": "^7.5.13",
      "socket.io-parser": "^3.3.6",
      "form-data": "^4.0.6"
    }
  }
}
